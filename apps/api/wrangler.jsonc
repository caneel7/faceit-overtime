{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "overtime-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "development",
    "APP_URL": "http://localhost:3000",
    "VERSION": "dev",
    "EMAIL_FROM": "no-reply@overtime.caneel.dev",
    "EMAIL_FROM_NAME": "Overtime",
    "MAILER": "resend",
    "ZEPTOMAIL_URL": "https://api.zeptomail.com/v1.1/email",
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "3987155b86df403695621cc4d1bb2d11" }],
  "ratelimits": [
    { "name": "SIGNIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "EMAIL_LIMITER", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } },
  ],
  "queues": {
    "producers": [{ "binding": "AUTH_QUEUE", "queue": "overtime-auth" }],
    "consumers": [
      {
        "queue": "overtime-auth",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "overtime-auth-dlq",
      },
    ],
  },
  "env": {
    "production": {
      "name": "overtime-api",
      "routes": [{ "pattern": "overtime-api.caneel.dev", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "APP_URL": "https://overtime.caneel.dev",
        "VERSION": "dev",
        "EMAIL_FROM": "no-reply@overtime.caneel.dev",
        "EMAIL_FROM_NAME": "Overtime",
        "MAILER": "resend",
        "ZEPTOMAIL_URL": "https://api.zeptomail.com/v1.1/email",
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "3987155b86df403695621cc4d1bb2d11" }],
      "ratelimits": [
        {
          "name": "SIGNIN_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 },
        },
        { "name": "IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
        { "name": "EMAIL_LIMITER", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } },
      ],
      "queues": {
        "producers": [{ "binding": "AUTH_QUEUE", "queue": "overtime-auth" }],
        "consumers": [
          {
            "queue": "overtime-auth",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "overtime-auth-dlq",
          },
        ],
      },
    },
  },
}
