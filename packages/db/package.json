  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "0.31.11",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
